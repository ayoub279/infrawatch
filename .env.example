# Copy using scripts/init.sh; never commit the resulting .env.
APP_NAME=InfraWatch
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=infrawatch
DB_USERNAME=infrawatch
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
MONITOR_ALLOWED_HOSTS=example.com
DEMO_PASSWORD=
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
RELEASE=local
